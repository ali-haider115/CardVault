<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root_land"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:padding="24dp">

    <!-- Horizontal Brand Layout for Landscape -->
    <LinearLayout
        android:id="@+id/layout_center_brand_land"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_splash_logo_land"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_card_vault" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_splash_title_land"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_short_name"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_splash_tagline_land"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/app_tagline"
                android:textColor="#C7D2FE"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Loading Bar at Bottom Right/Center for Landscape -->
    <ProgressBar
        android:id="@+id/pb_splash_loading_land"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:indeterminateTint="@color/accent_teal" />

</RelativeLayout>